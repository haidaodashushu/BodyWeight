[Unit]
Description=Body Weight Sync API
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/body-weight-server
EnvironmentFile=/etc/body-weight-api.env
ExecStart=/usr/bin/python3 /home/admin/body-weight-server/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/body-weight-api

[Install]
WantedBy=multi-user.target
