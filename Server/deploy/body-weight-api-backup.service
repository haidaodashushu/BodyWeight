[Unit]
Description=Back up Body Weight SQLite database
After=body-weight-api.service

[Service]
Type=oneshot
User=admin
Group=admin
EnvironmentFile=/etc/body-weight-api.env
ExecStart=/usr/bin/python3 /home/admin/body-weight-server/backup.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/body-weight-api /var/backups/body-weight-api
